<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="90HX Studio"
        Width="360" Height="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Microsoft YaHei, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>

        <DropShadowEffect x:Key="AppleIconShadow" Color="#000000" BlurRadius="52" ShadowDepth="18" Opacity="0.34" />
        <DropShadowEffect x:Key="AppleInnerGaze" Color="#000000" BlurRadius="8" ShadowDepth="3" Opacity="0.45" />
        <DropShadowEffect x:Key="AuraGlow" Color="#0071E3" BlurRadius="34" ShadowDepth="0" Opacity="0.5" />

        <Storyboard x:Key="AppleIconStoryboard">

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:0.00" Value="0.68" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.55" Value="1.07">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.82" Value="0.965">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.02" Value="1.018">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.18" Value="1.000">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0.00" Value="0.68" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.55" Value="1.07">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.82" Value="0.965">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.02" Value="1.018">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.18" Value="1.000">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimation Storyboard.TargetName="IconContainer" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.42">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="IconAura" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.85" BeginTime="0:0:0.18" Duration="0:0:0.75">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="AuraScale" Storyboard.TargetProperty="ScaleX"
                             From="0.82" To="1.06" BeginTime="0:0:0.18" Duration="0:0:2.1" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="AuraScale" Storyboard.TargetProperty="ScaleY"
                             From="0.82" To="1.06" BeginTime="0:0:0.18" Duration="0:0:2.1" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="SettleRing" Storyboard.TargetProperty="Opacity"
                             From="0.55" To="0" BeginTime="0:0:1.10" Duration="0:0:0.85">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX"
                             From="0.90" To="1.42" BeginTime="0:0:1.10" Duration="0:0:0.85">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY"
                             From="0.90" To="1.42" BeginTime="0:0:1.10" Duration="0:0:0.85">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="ShineTranslate" Storyboard.TargetProperty="X"
                             From="-200" To="240" BeginTime="0:0:0.42" Duration="0:0:1.05">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ShineBar" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.62" BeginTime="0:0:0.42" Duration="0:0:0.40" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="ShineTranslate2" Storyboard.TargetProperty="X"
                             From="-200" To="240" BeginTime="0:0:0.87" Duration="0:0:0.85">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ShineBar2" Storyboard.TargetProperty="Opacity"
                             From="0" To="0.30" BeginTime="0:0:0.87" Duration="0:0:0.32" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="BreathScale" Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="1.018" BeginTime="0:0:1.18" Duration="0:0:1.2" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BreathScale" Storyboard.TargetProperty="ScaleY"
                             From="1.0" To="1.018" BeginTime="0:0:1.18" Duration="0:0:1.2" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource AppleIconStoryboard}" />
        </EventTrigger>
    </Window.Triggers>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

        <Grid Name="IconAura" Width="196" Height="196" HorizontalAlignment="Center" VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5" Opacity="0">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="AuraScale" ScaleX="0.82" ScaleY="0.82" />
            </Grid.RenderTransform>
            <Ellipse Width="196" Height="196" Effect="{StaticResource AuraGlow}">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3DA5FF" Offset="0" />
                        <GradientStop Color="#0071E3" Offset="0.45" />
                        <GradientStop Color="#000071E3" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <Grid Name="SettleRing" Width="168" Height="168" HorizontalAlignment="Center" VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5" Opacity="0">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="RingScale" ScaleX="0.90" ScaleY="0.90" />
            </Grid.RenderTransform>
            <Ellipse Width="168" Height="168" Stroke="#7FC4FF" StrokeThickness="1.6" Opacity="0.9" />
        </Grid>

        <Grid Name="IconContainer" Width="148" Height="148" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1" />
                    <ScaleTransform x:Name="BreathScale" ScaleX="1" ScaleY="1" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Border Width="148" Height="148" CornerRadius="36" Background="#0A0B0D" Effect="{StaticResource AppleIconShadow}" Opacity="0.65" />

            <Border Width="148" Height="148" CornerRadius="36" SnapsToDevicePixels="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#25272B" Offset="0" />
                        <GradientStop Color="#1B1C1F" Offset="0.5" />
                        <GradientStop Color="#121315" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid ClipToBounds="True">

                    <Border BorderThickness="1.2" CornerRadius="36">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#5AFFFFFF" Offset="0" />
                                <GradientStop Color="#1AFFFFFF" Offset="0.3" />
                                <GradientStop Color="#08FFFFFF" Offset="0.7" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                    </Border>

                    <Ellipse Width="130" Height="130" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-35,-35,0" Opacity="0.14">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#0071E3" Offset="0" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <TextBlock Text="90" Foreground="#FFFFFF" FontWeight="Bold" FontSize="66"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="3" Opacity="0.45" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <Border Name="ShineBar" Width="55" Height="220" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="28" />
                                <TranslateTransform x:Name="ShineTranslate" X="-200" Y="0" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="#70FFFFFF" Offset="0.5" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Border Name="ShineBar2" Width="26" Height="220" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="28" />
                                <TranslateTransform x:Name="ShineTranslate2" X="-200" Y="0" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="#B4FFFFFF" Offset="0.5" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                </Grid>
            </Border>
        </Grid>

        <TextBlock Name="TxtSplashStatus" Visibility="Collapsed" />
        <ProgressBar Name="SplashProgressBar" Visibility="Collapsed" />
    </Grid>
</Window>
