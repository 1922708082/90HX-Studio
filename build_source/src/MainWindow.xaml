                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource SuccessGreen}" Margin="0,0,6,0" />
                        <TextBlock Name="TxtBarClock" Text="00:00:00" FontFamily="Consolas, monospace" FontSize="10.5" Foreground="{StaticResource TextSub}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

