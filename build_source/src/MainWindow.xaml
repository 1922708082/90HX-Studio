<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HX家族多功能工具箱 - Apple Studio"
        Width="1240" Height="780" MinWidth="1160" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
        FontSize="12"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Apple Studio Focus Visual -->
        <Style x:Key="AppFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" Stroke="#0071E3" StrokeThickness="1.5" RadiusX="14" RadiusY="14" Opacity="0.8" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apple Studio Light Workstation Palette (浅色工坊: #F5F5F7 软钛银中性灰) -->
        <SolidColorBrush x:Key="BgApp" Color="#F5F5F7" />
        <SolidColorBrush x:Key="BgSidebar" Color="#EBEBED" />
        <SolidColorBrush x:Key="BgWhite" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BgCard" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BgSubtle" Color="#FBFBFD" />
        <SolidColorBrush x:Key="BgHover" Color="#F0F0F2" />
        <SolidColorBrush x:Key="BgActive" Color="#E5E5EA" />
        <SolidColorBrush x:Key="BgBanner" Color="#F0F4FA" />

        <!-- 极细半透明边框 (1px solid rgba(0,0,0,0.08)) -->
        <SolidColorBrush x:Key="BorderLight" Color="#14000000" />
        <SolidColorBrush x:Key="BorderMedium" Color="#22000000" />
        <SolidColorBrush x:Key="BorderBanner" Color="#200071E3" />

        <!-- Apple Studio Dark Obsidian Palette (暗色黑曜石现代材质: #1C1C1E) -->
        <SolidColorBrush x:Key="BgAppDark" Color="#1C1C1E" />
        <SolidColorBrush x:Key="BgSidebarDark" Color="#161618" />
        <SolidColorBrush x:Key="BgCardDark" Color="#2C2C2E" />
        <SolidColorBrush x:Key="BorderDark" Color="#20FFFFFF" />
        <SolidColorBrush x:Key="TextMainDark" Color="#F5F5F7" />
        <SolidColorBrush x:Key="TextSubDark" Color="#8E8E93" />

        <!-- 工业语义色彩体系 -->
        <SolidColorBrush x:Key="AccentBlue" Color="#0071E3" />
        <SolidColorBrush x:Key="AccentBlueHover" Color="#0077ED" />
        <SolidColorBrush x:Key="AccentBluePressed" Color="#005BB5" />
        <SolidColorBrush x:Key="AccentBlueSubtle" Color="#EBF4FD" />

        <SolidColorBrush x:Key="SuccessGreen" Color="#34C759" />
        <SolidColorBrush x:Key="WarningAmber" Color="#FF9500" />
        <SolidColorBrush x:Key="DangerRed" Color="#FF3B30" />
        <SolidColorBrush x:Key="PurpleViolet" Color="#AF52DE" />
        <SolidColorBrush x:Key="PinkRose" Color="#FF2D55" />
        <SolidColorBrush x:Key="CyanSky" Color="#32ADE6" />
        <SolidColorBrush x:Key="TealGreen" Color="#30B0C7" />

        <!-- macOS 窗口控制红黄绿三色 -->
        <SolidColorBrush x:Key="TrafficClose" Color="#FF5F56" />
        <SolidColorBrush x:Key="TrafficMin" Color="#FFBD2E" />
        <SolidColorBrush x:Key="TrafficMax" Color="#27C93F" />

        <!-- 字体与阶层 -->
        <SolidColorBrush x:Key="TextMain" Color="#1D1D1F" />
        <SolidColorBrush x:Key="TextSub" Color="#6E6E73" />
        <SolidColorBrush x:Key="TextMuted" Color="#86868B" />

        <!-- 柔和环境光弥散阴影 -->
        <DropShadowEffect x:Key="ShadowSm" Color="#000000" BlurRadius="12" ShadowDepth="1" Opacity="0.04" Direction="270" />
        <DropShadowEffect x:Key="ShadowCard" Color="#000000" BlurRadius="20" ShadowDepth="2" Opacity="0.05" Direction="270" />
        <DropShadowEffect x:Key="ShadowFloat" Color="#000000" BlurRadius="32" ShadowDepth="4" Opacity="0.08" Direction="270" />

        <!-- 通用卡片容器样式 (大圆角 16px 连续超椭圆) -->
        <Style x:Key="HoverCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Effect" Value="{StaticResource ShadowCard}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- 标题样式 -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PageDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSub}" />
            <Setter Property="LineHeight" Value="17" />
        </Style>

        <!-- 侧边栏分组标题 -->
        <Style x:Key="NavGroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Margin" Value="16,14,16,6" />
        </Style>

        <!-- 侧边栏按钮样式 (图标与文字) -->
        <Style x:Key="NavItemBtn" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="10,2,10,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="12,0,12,0" SnapsToDevicePixels="True">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="icon" Grid.Column="0" Data="{TemplateBinding Tag}" Stroke="{StaticResource TextSub}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" RecognizesAccessKey="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}" />
                                <Setter Property="Foreground" Value="{StaticResource TextMain}" />
                                <Setter TargetName="icon" Property="Stroke" Value="{StaticResource TextMain}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="bd" Property="Effect" Value="{StaticResource ShadowSm}" />
                                <Setter Property="Foreground" Value="{StaticResource TextMain}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="icon" Property="Stroke" Value="{StaticResource AccentBlue}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代标准按钮 -->
        <Style x:Key="StandardBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#FFFFFF" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" Effect="{StaticResource ShadowSm}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderMedium}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgActive}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代主行动按钮 (Apple 蓝) -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0,16,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource AccentBlue}" BorderThickness="0" CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" Effect="{StaticResource ShadowSm}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBlueHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBluePressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险警示按钮 -->
        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource DangerRed}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#FFF1F0" BorderBrush="#33FF3B30" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE5E5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerRed}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 交通灯圆形按钮样式 -->
        <Style x:Key="TrafficLightBtn" TargetType="Button">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="dot" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="0.6" Width="12" Height="12" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" x:Name="cp" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cp" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 通道选择大卡片 RadioButton 样式 -->
        <Style x:Key="ChannelCardRadio" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#FFFFFF" BorderBrush="{StaticResource BorderLight}" BorderThickness="1.5" CornerRadius="14" Padding="14,12" SnapsToDevicePixels="True" Effect="{StaticResource ShadowSm}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderMedium}" />
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBlue}" />
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBlueSubtle}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GpuModelRadio" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#FFFFFF" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="12,8" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBlue}" />
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBlueSubtle}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 开关 CheckBox -->
        <Style x:Key="ModernSwitchCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="track" Width="36" Height="20" CornerRadius="10" Background="#E5E5EA" Margin="0,0,8,0">
                                <Ellipse x:Name="thumb" Width="16" Height="16" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="2,0,2,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.18" Color="#000000" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource SuccessGreen}" />
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 终端日志框样式 -->
        <Style x:Key="TerminalLogBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1C1C1E" />
            <Setter Property="Foreground" Value="#D1D1D6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New, monospace" />
            <Setter Property="FontSize" Value="11" />
                    </Style>

        <Style x:Key="StatusCell" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="StatusValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
        </Style>
        <Style x:Key="SidebarFooter" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
    </Window.Resources>

    <!-- 主窗口外壳：带环境光微光弥散外阴影的大圆角窗口 -->
    <Border CornerRadius="18" Background="{StaticResource BgApp}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="36" ShadowDepth="8" Opacity="0.14" Direction="270" />
        </Border.Effect>

        <Grid Name="MainRootGrid" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 管理员提示条 -->
                <RowDefinition Height="46" />   <!-- macOS 风格统合顶栏 -->
                <RowDefinition Height="*" />    <!-- 主体区域：侧边栏 + 内容区 -->
                <RowDefinition Height="28" />   <!-- 底部全局状态栏 -->
            </Grid.RowDefinitions>

            <!-- 0. 管理员警告横幅 (Apple 琥珀金胶囊) -->
            <Border Name="BannerAdminWarning" Grid.Row="0" Background="#FFF9F0" BorderBrush="#40FF9500" BorderThickness="0,0,0,1" Padding="16,8" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource WarningAmber}" Margin="0,0,10,0" />
                        <TextBlock Text="未以管理员权限运行。固件引导与底层驱动注册表配置需要提升权限。" Foreground="#8A5300" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Name="BtnRestartAsAdmin" Grid.Column="1" Content="以管理员权限重新启动" Style="{StaticResource StandardBtn}" Height="26" Padding="12,0,12,0" Background="#FF9500" Foreground="#FFFFFF" BorderBrush="#FF9500" FontWeight="SemiBold" />
                </Grid>
            </Border>

            <!-- 1. macOS 统合顶栏 (红黄绿交通灯 + 金属徽标 + 全局遥测胶囊) -->
            <Border Grid.Row="1" Name="TopDragBar" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
                <Grid Margin="16,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" /> <!-- 左侧：交通灯 + 金属徽标 -->
                        <ColumnDefinition Width="*" />   <!-- 右侧：全局状态遥测胶囊 + 快速操作 -->
                    </Grid.ColumnDefinitions>

                    <!-- 左侧控制区 -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- macOS 红黄绿圆形三色控制区 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Name="BtnWinClose" Style="{StaticResource TrafficLightBtn}" Background="{StaticResource TrafficClose}" BorderBrush="#E0443E" Margin="0,0,8,0" ToolTip="关闭窗口">
                                <Path Data="M3,3 L9,9 M9,3 L3,9" Stroke="#4D0000" StrokeThickness="1.2" Width="6" Height="6" Stretch="Uniform" />
                            </Button>
                            <Button Name="BtnWinMin" Style="{StaticResource TrafficLightBtn}" Background="{StaticResource TrafficMin}" BorderBrush="#DEA123" Margin="0,0,8,0" ToolTip="最小化">
                                <Rectangle Width="6" Height="1.2" Fill="#5C3B00" />
                            </Button>
                            <Button Name="BtnWinMax" Style="{StaticResource TrafficLightBtn}" Background="{StaticResource TrafficMax}" BorderBrush="#1AAB29" ToolTip="最大化 / 还原">
                                <Path Data="M2,2 H8 V8 H2 Z" Stroke="#004D0D" StrokeThickness="1" Width="5.5" Height="5.5" Stretch="Uniform" />
                            </Button>
                        </StackPanel>

                        <!-- 分隔微点 -->
                        <Rectangle Grid.Column="1" Width="1" Height="14" Fill="{StaticResource BorderLight}" HorizontalAlignment="Center" />

                        <!-- HX 品牌金属徽标 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="7" Margin="0,0,8,0" BorderBrush="#3A3A3C" BorderThickness="0.8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2C2C2E" Offset="0.0" />
                                        <GradientStop Color="#1C1C1E" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="HX" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="HX Studio" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextMain}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 右侧：全局实时遥测胶囊与一键调优 -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 遥测胶囊排布 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <!-- 显卡型号胶囊 -->
                            <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,8,0" Effect="{StaticResource ShadowSm}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M4,6 H20 V16 H4 Z M9,16 V18 M15,16 V18 M7,18 H17" Stroke="{StaticResource AccentBlue}" StrokeThickness="1.2" Width="12" Height="12" Margin="0,0,6,0" Stretch="Uniform" />
                                    <TextBlock Name="TxtTopGpuModel" Text="正在检测显卡设备..." FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextMain}" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <!-- PCIe 链路胶囊 -->
                            <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,8,0" Effect="{StaticResource ShadowSm}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBlue}" Margin="0,0,6,0" />
                                    <TextBlock Text="PCIe: " Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBlock Name="TxtTopPcieStatus" Text="检测中..." FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <!-- 游戏覆盖胶囊 -->
                            <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,8,0" Effect="{StaticResource ShadowSm}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessGreen}" Margin="0,0,6,0" />
                                    <TextBlock Text="覆盖: " Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBlock Name="TxtTopOverlayStatus" Text="检测中..." FontWeight="SemiBold" Foreground="{StaticResource TextMain}" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <!-- 实时温控功耗胶囊 -->
                            <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="10,4" Effect="{StaticResource ShadowSm}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessGreen}" Margin="0,0,6,0" />
                                    <TextBlock Name="TxtTopSensors" Text="-- ℃ · -- W" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreen}" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 右侧动作按钮 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Name="BtnTopRefresh" Content="刷新" Style="{StaticResource StandardBtn}" Height="28" Padding="12,0,12,0" Margin="0,0,8,0" />
                            <Button Name="BtnTopAutoOptimize" Content="全自动最优配置" Style="{StaticResource PrimaryBtn}" Height="28" Padding="14,0,14,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 2. 主体工作区 (侧边栏 + 5 大现代工作区内容容器) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" /> <!-- Apple 侧边栏 -->
                    <ColumnDefinition Width="*" />   <!-- 工作区内容 -->
                </Grid.ColumnDefinitions>

                <!-- 侧边栏 -->
                <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />    <!-- 导航菜单 -->
                            <RowDefinition Height="Auto" /> <!-- 底部快捷呼出「AI 助手」按钮与版本信息 -->
                        </Grid.RowDefinitions>

                        <!-- 导航列表：5 大现代工作区 -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8,0,8">
                            <StackPanel>
                                <TextBlock Text="工作区" Style="{StaticResource NavGroupTitle}" />

                                <!-- 1. 驾驶舱遥测中枢 -->
                                <RadioButton Name="NavItemHardware" Style="{StaticResource NavItemBtn}" Content="驾驶舱遥测中枢" IsChecked="True"
                                             Tag="M12,2 A10,10 0 0,0 2,12 A10,10 0 0,0 12,22 A10,10 0 0,0 22,12 A10,10 0 0,0 12,2 Z M12,6 V12 L16,14" />

                                <!-- 2. 固件引导级解锁矩阵 -->
                                <RadioButton Name="NavItemMatrix" Style="{StaticResource NavItemBtn}" Content="固件引导解锁矩阵"
                                             Tag="M6,4 H18 V8 H6 Z M4,8 H20 V18 H4 Z M8,12 H16 M8,15 H13" />

                                <!-- 3. 显卡型号深度伪装中心 -->
                                <RadioButton Name="NavItemSpoof" Style="{StaticResource NavItemBtn}" Content="显卡型号伪装中心"
                                             Tag="M4,7 H20 M4,12 H20 M4,17 H20 M7,4 V20 M17,4 V20" />

                                <!-- 4. 自适应动态能效中枢 -->
                                <RadioButton Name="NavItemPower" Style="{StaticResource NavItemBtn}" Content="自适应动态能效中枢"
                                             Tag="M13,2 L4,14 H11 L10,22 L20,9 H13 Z" />

                                <!-- 5. NVIDIA App 覆盖与 DLSS 3 运行库 -->
                                <RadioButton Name="NavItemDlss" Style="{StaticResource NavItemBtn}" Content="覆盖与 DLSS 运行库"
                                             Tag="M4,5 H20 V15 H4 Z M8,19 H16 M12,15 V19" />

                                <!-- 分隔线 -->
                                <Rectangle Height="1" Fill="{StaticResource BorderLight}" Margin="16,12,16,8" />

                                <TextBlock Text="系统与支持" Style="{StaticResource NavGroupTitle}" />
                                <RadioButton Name="NavItemLogs" Style="{StaticResource NavItemBtn}" Content="运行审计日志"
                                             Tag="M4,4 H20 V20 H4 Z M8,8 H16 M8,12 H16 M8,16 H12" />
                                <RadioButton Name="NavItemUpdate" Style="{StaticResource NavItemBtn}" Content="软件更新与关于"
                                             Tag="M12,4 V14 M8,10 L12,14 L16,10 M4,18 H20" />
                                <RadioButton Name="NavItemSponsor" Style="{StaticResource NavItemBtn}" Content="开发者支持"
                                             Tag="M12,21.35 L10.55,20.03 C5.4,15.36 2,12.28 2,8.5 C2,5.42 4.42,3 7.5,3 C9.24,3 10.91,3.81 12,5.09 C13.09,3.81 14.76,3 16.5,3 C19.58,3 22,5.42 22,8.5 C22,12.28 18.6,15.36 13.45,20.04 L12,21.35 Z" />

                                <!-- 隐藏的辅助导航项 (保持 App.cs 索引与逻辑绝对稳定) -->
                                <RadioButton Name="NavItemOverlay" Visibility="Collapsed" />
                                <RadioButton Name="NavItemUnlock50" Visibility="Collapsed" />
                                <RadioButton Name="NavItemUnlock40" Visibility="Collapsed" />
                                <RadioButton Name="NavItemDualGpu" Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 侧边栏底部：快捷呼出「AI 助手」按钮 + 版本号 -->
                        <Border Grid.Row="1" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="12,10,12,10" Background="{StaticResource BgSidebar}">
                            <StackPanel>
                                <!-- Apple 风格 AI 助手快捷呼出胶囊 -->
                                <Button Name="BtnOpenAiAssistant" Style="{StaticResource StandardBtn}" Height="36" Padding="10,0,10,0" Margin="0,0,0,8" ToolTip="呼出 Apple 风格 AI 智能硬件诊断与系统调优助理">
                                    <Grid HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 晶体微光矢量图标 -->
                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#0071E3" Offset="0.0" />
                                                    <GradientStop Color="#AF52DE" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Path Data="M9,2 L10.5,6.5 L15,8 L10.5,9.5 L9,14 L7.5,9.5 L3,8 L7.5,6.5 Z" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="AI 智能调优助理" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextMain}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <Grid>
                                    <TextBlock Name="TxtSidebarVersion" Text="HX Studio v5.0 Sequoia" Style="{StaticResource SidebarFooter}" VerticalAlignment="Center" />
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessGreen}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="核心服务在线" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 工作区内容宿主容器 -->
                <Grid Grid.Column="1" Name="PageHost" Background="{StaticResource BgApp}">

                    <!-- ======================================================== -->
                    <!-- 工作区 1：驾驶舱遥测中枢 (PageHardware)                     -->
                    <!-- ======================================================== -->
                    <Grid Name="PageHardware" Visibility="Visible" Margin="22,18,22,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- 工作区头部 -->
                            <RowDefinition Height="*" />    <!-- 双环形仪表与全景瓦片 -->
                        </Grid.RowDefinitions>

                        <!-- 头部标题 -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource AccentBlue}" Margin="0,0,8,0" />
                                    <TextBlock Text="驾驶舱遥测中枢" Style="{StaticResource PageTitle}" />
                                </StackPanel>
                                <TextBlock Text="硬件资产全景拓扑 · 核心传感器实时遥测 · 动态 P-State 监控" Style="{StaticResource PageDesc}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Name="ChkAutoRefreshSensors" Content="自动轮询" Style="{StaticResource ModernSwitchCheckBox}" IsChecked="True" Margin="0,0,12,0" />
                                <Button Name="BtnRefreshSensorsOnce" Content="立即刷新" Style="{StaticResource StandardBtn}" Height="30" Padding="12,0,12,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="310" />
                            </Grid.ColumnDefinitions>

                            <!-- 左主侧：双环形仪表盘 + 全景瓦片网格 -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,14,10">
                                <StackPanel>

                                    <!-- 双环形仪表大卡片 (Apple Studio 双环精密刻度盘) -->
                                    <Border Style="{StaticResource HoverCardBorder}" Padding="20,18" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="核心动态遥测" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextMain}" VerticalAlignment="Center" />
                                                    <Border Background="{StaticResource AccentBlueSubtle}" CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="NVML 纳秒级" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Name="TxtSensClocks" Text="-- MHz / -- MHz" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- 双环刻度盘布局 -->
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="1" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 环形 1：核心温度刻度盘 -->
                                                <Grid Grid.Column="0" HorizontalAlignment="Center">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Grid Width="110" Height="110">
                                                            <!-- 背景底座刻度环 -->
                                                            <Ellipse Stroke="#E5E5EA" StrokeThickness="7" />
                                                            <!-- 动态温度进度弧 -->
                                                            <Ellipse Name="RingDashTemp" Stroke="{StaticResource AccentBlue}" StrokeThickness="7" StrokeDashArray="1 400" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                                                <Ellipse.RenderTransform>
                                                                    <RotateTransform Angle="-90" />
                                                                </Ellipse.RenderTransform>
                                                            </Ellipse>
                                                            <!-- 刻度盘中央读数 -->
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Name="TxtRingDashTempVal" Text="--°" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" />
                                                                <TextBlock Text="核心温度" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <!-- 辅助数据条 -->
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                            <TextBlock Text="瞬时: " FontSize="11" Foreground="{StaticResource TextMuted}" />
                                                            <TextBlock Name="TxtSensTemp" Text="-- ℃" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                                                        </StackPanel>
                                                        <ProgressBar Name="BarSensTemp" Maximum="90" Height="3" Width="90" Margin="0,4,0,0" Foreground="{StaticResource AccentBlue}" Background="#E5E5EA" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- 细分隔线 -->
                                                <Rectangle Grid.Column="1" Fill="{StaticResource BorderLight}" VerticalAlignment="Stretch" Margin="0,6,0,6" />

                                                <!-- 环形 2：TGP 功耗刻度盘 -->
                                                <Grid Grid.Column="2" HorizontalAlignment="Center">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Grid Width="110" Height="110">
                                                            <!-- 背景底座刻度环 -->
                                                            <Ellipse Stroke="#E5E5EA" StrokeThickness="7" />
                                                            <!-- 动态功耗进度弧 -->
                                                            <Ellipse Name="RingDashPower" Stroke="{StaticResource SuccessGreen}" StrokeThickness="7" StrokeDashArray="1 400" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                                                <Ellipse.RenderTransform>
                                                                    <RotateTransform Angle="-90" />
                                                                </Ellipse.RenderTransform>
                                                            </Ellipse>
                                                            <!-- 刻度盘中央读数 -->
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Name="TxtRingDashPowerVal" Text="--W" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" />
                                                                <TextBlock Text="实时 TGP" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <!-- 辅助数据条 -->
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                            <TextBlock Text="功耗: " FontSize="11" Foreground="{StaticResource TextMuted}" />
                                                            <TextBlock Name="TxtSensPower" Text="-- W / -- W" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                                                        </StackPanel>
                                                        <ProgressBar Name="BarSensPower" Maximum="250" Height="3" Width="90" Margin="0,4,0,0" Foreground="{StaticResource SuccessGreen}" Background="#E5E5EA" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- 全景瓦片网格 (PCIe / P-State / 显存 / 负荷 / 风扇) -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 瓦片 1：PCIe 链路与位宽 -->
                                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource HoverCardBorder}" Padding="14,12" Margin="0,0,8,10">
                                            <StackPanel>
                                                <TextBlock Text="PCIe 链路状态" Style="{StaticResource StatusLabel}" />
                                                <TextBlock Name="TxtSensPcieLink" Text="检测中..." FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" TextTrimming="CharacterEllipsis" Margin="0,2,0,4" />
                                                <TextBlock Name="TxtDashPcie" Text="链路正常" FontSize="10.5" Foreground="{StaticResource TextMuted}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 瓦片 2：P-State 动态能效与省电联动 -->
                                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource HoverCardBorder}" Padding="14,12" Margin="4,0,4,10">
                                            <StackPanel>
                                                <TextBlock Text="电源模式 (P-State)" Style="{StaticResource StatusLabel}" />
                                                <TextBlock Name="TxtSensPstate" Text="P-State: 检测中..." FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis" Margin="0,2,0,4" />
                                                <TextBlock Name="TxtDashPowerState" Text="就绪" FontSize="10.5" Foreground="{StaticResource SuccessGreen}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 瓦片 3：显存占用全景 -->
                                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource HoverCardBorder}" Padding="14,12" Margin="8,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="显存占用 (VRAM)" Style="{StaticResource StatusLabel}" />
                                                <TextBlock Name="TxtSensVram" Text="-- MB / -- MB" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,2,0,6" />
                                                <ProgressBar Name="BarSensVram" Maximum="10240" Height="4" Foreground="{StaticResource PurpleViolet}" Background="#E5E5EA" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 瓦片 4：GPU 核心利用率 -->
                                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource HoverCardBorder}" Padding="14,12" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="GPU 核心负荷" Style="{StaticResource StatusLabel}" />
                                                <TextBlock Name="TxtSensUtil" Text="-- %" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,2,0,6" />
                                                <ProgressBar Name="BarSensUtil" Maximum="100" Height="4" Foreground="{StaticResource CyanSky}" Background="#E5E5EA" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 瓦片 5：散热风扇转速 -->
                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource HoverCardBorder}" Padding="14,12" Margin="4,0,4,0">
                                            <StackPanel>
                                                <TextBlock Text="风扇散热转速" Style="{StaticResource StatusLabel}" />
                                                <TextBlock Name="TxtSensFan" Text="-- %" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,2,0,6" />
                                                <ProgressBar Name="BarSensFan" Maximum="100" Height="4" Foreground="{StaticResource TealGreen}" Background="#E5E5EA" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 瓦片 6：游戏覆盖状态 -->
                                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource HoverCardBorder}" Padding="14,12" Margin="8,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="NVIDIA 游戏覆盖" Style="{StaticResource StatusLabel}" />
                                                <TextBlock Name="TxtDashOverlay" Text="免检中..." FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreen}" Margin="0,2,0,4" />
                                                <TextBlock Text="CEF 覆盖环境就绪" FontSize="10.5" Foreground="{StaticResource TextMuted}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- 硬件全景资产卡片 (CPU, 主板, BIOS, 内存, 操作系统, 显示等) -->
                                    <Border Style="{StaticResource HoverCardBorder}" Padding="18,16" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="主机硬件资产总览" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextMain}" Margin="0,0,0,12" />

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 主板 & BIOS -->
                                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                                                    <TextBlock Text="主机主板" Style="{StaticResource StatusLabel}" />
                                                    <TextBlock Name="TxtHwMotherboard" Text="检测中..." Style="{StaticResource StatusValue}" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                                    <TextBlock Text="BIOS 固件版本" Style="{StaticResource StatusLabel}" />
                                                    <TextBlock Name="TxtHwBiosVer" Text="检测中..." Style="{StaticResource StatusValue}" />
                                                </StackPanel>

                                                <!-- CPU 处理器 -->
                                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,10">
                                                    <TextBlock Text="CPU 处理器" Style="{StaticResource StatusLabel}" />
                                                    <TextBlock Name="TxtHwCpuName" Text="检测中..." Style="{StaticResource StatusValue}" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                                    <TextBlock Text="核心 / 线程 / 主频" Style="{StaticResource StatusLabel}" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Name="TxtHwCpuCores" Text="-- 核" Style="{StaticResource StatusValue}" Margin="0,0,8,0" />
                                                        <TextBlock Name="TxtHwCpuClock" Text="-- GHz" Style="{StaticResource StatusValue}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- 内存 & 操作系统 -->
                                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,10">
                                                    <TextBlock Text="系统内存 (RAM)" Style="{StaticResource StatusLabel}" />
                                                    <TextBlock Name="TxtHwMemory" Text="检测中..." Style="{StaticResource StatusValue}" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                                                    <TextBlock Text="操作系统版本" Style="{StaticResource StatusLabel}" />
                                                    <TextBlock Name="TxtHwOsVer" Text="检测中..." Style="{StaticResource StatusValue}" />
                                                </StackPanel>

                                                <!-- UEFI, 安全启动与 HAGS -->
                                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="固件引导模式 / 安全启动" Style="{StaticResource StatusLabel}" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Name="TxtHwUefiState" Text="UEFI" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreen}" Margin="0,0,10,0" />
                                                        <TextBlock Name="TxtHwSecureBoot" Text="安全启动: 开启" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Row="3" Grid.Column="1">
                                                    <TextBlock Text="硬件加速 GPU 计划 (HAGS)" Style="{StaticResource StatusLabel}" />
                                                    <TextBlock Name="TxtHwHags" Text="已激活" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreen}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- 辅助硬件参数 (磁盘, 显示器, 音频, 网络) -->
                                            <Border Background="{StaticResource BgSubtle}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,12,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="磁盘" Style="{StaticResource StatusLabel}" />
                                                        <TextBlock Name="TxtHwDisk" Text="检测中..." FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="显示器" Style="{StaticResource StatusLabel}" />
                                                        <TextBlock Name="TxtHwMonitor" Text="检测中..." FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="音频设备" Style="{StaticResource StatusLabel}" />
                                                        <TextBlock Name="TxtHwAudio" Text="检测中..." FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3">
                                                        <TextBlock Text="网络适配器" Style="{StaticResource StatusLabel}" />
                                                        <TextBlock Name="TxtHwNetwork" Text="检测中..." FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 右侧栏：GPU 设备树与快捷调度 -->
                            <Border Grid.Column="1" Style="{StaticResource HoverCardBorder}" Padding="16,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                        <TextBlock Text="已识别 GPU 硬件设备" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextMain}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="设备数量: " FontSize="11" Foreground="{StaticResource TextMuted}" />
                                            <TextBlock Name="TxtHwGpuCount" Text="0 个" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 显卡设备列表 -->
                                    <Border Grid.Row="1" Background="{StaticResource BgSubtle}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="6" Margin="0,0,0,12">
                                        <ListBox Name="LstAllGpuDevices" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    </Border>

                                    <!-- 快捷调控动作卡 -->
                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="快速调度操作" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextMain}" Margin="0,0,0,8" />
                                        <Button Name="BtnDashRename" Content="一键伪装 RTX 5090" Style="{StaticResource PrimaryBtn}" Height="32" Margin="0,0,0,6" />
                                        <Button Name="BtnDashUnlock" Content="动态节能管理" Style="{StaticResource StandardBtn}" Height="32" Margin="0,0,0,6" />
                                        <Button Name="BtnDashRestart" Content="软重启显卡驱动" Style="{StaticResource StandardBtn}" Height="32" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ======================================================== -->
                    <!-- 工作区 2：固件引导级解锁矩阵 (PageMatrix)                   -->
                    <!-- ======================================================== -->
                    <Grid Name="PageMatrix" Visibility="Collapsed" Margin="22,18,22,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 头部标题 -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource AccentBlue}" Margin="0,0,8,0" />
                                    <TextBlock Text="固件引导级解锁矩阵" Style="{StaticResource PageTitle}" />
                                </StackPanel>
                                <TextBlock Text="硬件直通 PCIe Gen2 · 图形 / 算力 / 光追全解锁三通道架构" Style="{StaticResource PageDesc}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Name="BtnRescanMiningGpus" Content="重新扫描硬件" Style="{StaticResource StandardBtn}" Height="30" Padding="14,0,14,0" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,14,10">
                                <StackPanel>

                                    <!-- 硬件状态横幅警告 (若无 90HX) -->
                                    <Border Name="BannerNo90hxWarning" Background="#FFF9F0" BorderBrush="#30FF9500" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource WarningAmber}" Margin="0,0,10,0" />
                                            <StackPanel>
                                                <TextBlock Text="未检测到 CMP 90HX 硬件设备" FontWeight="SemiBold" Foreground="#8A5300" FontSize="12" />
                                                <TextBlock Text="请检查 PCIe 供电线及主板 BIOS Above 4G 解码是否开启。" Foreground="#B45309" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 核心状态卡片 -->
                                    <Border Name="Card90hxStatusInfo" Style="{StaticResource HoverCardBorder}" Padding="18,14" Margin="0,0,0,16">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="90HX 链路与核心运行状态" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextMain}" />
                                                <TextBlock Name="TxtMiningGpuSummary" Text="检测中..." Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" />
                                            </Grid>
                                            <Border Background="{StaticResource BgSubtle}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="PCIe 物理总线:" Style="{StaticResource StatusLabel}" />
                                                        <TextBlock Name="TxtPcieCurrentMode" Text="PCIe Gen2 x16 (5.0 GT/s)" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreen}" FontSize="12" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Tensor Core 算力:" Style="{StaticResource StatusLabel}" />
                                                        <TextBlock Text="P0 满载已解除" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" FontSize="12" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="BCD 引导完整性:" Style="{StaticResource StatusLabel}" />
                                                        <TextBlock Name="TxtPcieBcdHealth" Text="校验健康" FontWeight="SemiBold" Foreground="{StaticResource PurpleViolet}" FontSize="12" />
                                                        <TextBlock Name="TxtSecureBootState" Text="安全启动状态良好" Visibility="Collapsed" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- 三通道大卡片矩阵 (现代 UEFI、老主板 Shell、救援 U 盘) -->
                                    <TextBlock Text="引导通道架构 (三通道可选)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextMain}" Margin="2,0,0,8" />

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 通道 1：现代 UEFI 直启卡片 -->
                                        <RadioButton Grid.Column="0" Name="RadioChannelA" GroupName="ChannelChoice" IsChecked="True" Style="{StaticResource ChannelCardRadio}" Margin="0,0,6,0">
                                            <StackPanel>
                                                <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentBlueSubtle}" Margin="0,0,0,8" HorizontalAlignment="Left">
                                                    <Path Data="M4,4 H20 V20 H4 Z M9,9 H15 V15 H9 Z" Stroke="{StaticResource AccentBlue}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" />
                                                </Border>
                                                <TextBlock Text="现代 UEFI 直启" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextMain}" />
                                                <TextBlock Text="NVPermissive EFI 补丁，免 Shell 秒进 Windows 系统 (推荐通道)" FontSize="10.5" Foreground="{StaticResource TextSub}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="15" />
                                            </StackPanel>
                                        </RadioButton>

                                        <!-- 通道 2：老主板 Shell 兼容引导卡片 -->
                                        <RadioButton Grid.Column="1" Name="RadioChannelB" GroupName="ChannelChoice" Style="{StaticResource ChannelCardRadio}" Margin="3,0,3,0">
                                            <StackPanel>
                                                <Border Width="28" Height="28" CornerRadius="8" Background="#F0F4FA" Margin="0,0,0,8" HorizontalAlignment="Left">
                                                    <Path Data="M4,17 L10,11 L4,5 M12,19 H20" Stroke="{StaticResource TextMain}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" />
                                                </Border>
                                                <TextBlock Text="老主板 Shell 引导" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextMain}" />
                                                <TextBlock Text="华南、精粤等老架构主板专属，EFI Shell 内存映射防黑屏" FontSize="10.5" Foreground="{StaticResource TextSub}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="15" />
                                            </StackPanel>
                                        </RadioButton>

                                        <!-- 通道 3：救援与应急 U 盘引导卡片 -->
                                        <RadioButton Grid.Column="2" Name="RadioChannelD" GroupName="ChannelChoice" Style="{StaticResource ChannelCardRadio}" Margin="6,0,0,0">
                                            <StackPanel>
                                                <Border Width="28" Height="28" CornerRadius="8" Background="#F5F0FF" Margin="0,0,0,8" HorizontalAlignment="Left">
                                                    <Path Data="M6,6 H18 V18 H6 Z M9,2 H15 V6 H9 Z" Stroke="{StaticResource PurpleViolet}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" />
                                                </Border>
                                                <TextBlock Text="救援 U 盘引导" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextMain}" />
                                                <TextBlock Text="免写本机磁盘，独立制作启动介质，支持开机临时引导与脱机修复" FontSize="10.5" Foreground="{StaticResource TextSub}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="15" />
                                            </StackPanel>
                                        </RadioButton>

                                        <!-- 兼容保留 RadioChannelC -->
                                        <RadioButton Name="RadioChannelC" GroupName="ChannelChoice" Visibility="Collapsed" />
                                    </Grid>

                                    <!-- U 盘通道专属配置抽屉 -->
                                    <Border Name="PanelUsbPicker" Style="{StaticResource HoverCardBorder}" Padding="16,12" Margin="0,0,0,16" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="可移动介质直写通道" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextMain}" Margin="0,0,0,8" />
                                            <WrapPanel>
                                                <TextBlock Text="目标 U 盘:" VerticalAlignment="Center" Foreground="{StaticResource TextSub}" FontSize="11.5" Margin="0,0,8,0" />
                                                <ComboBox Name="CmbUsbDrives" Width="220" Height="30" SelectedIndex="0" Margin="0,0,8,0" />
                                                <Button Name="BtnRefreshUsbDrives" Content="刷新驱动器" Style="{StaticResource StandardBtn}" Height="30" Margin="0,0,8,0" />
                                                <Button Name="BtnUsbSetFirst" Content="置顶启动项" Style="{StaticResource PrimaryBtn}" Height="30" Margin="0,0,8,0" />
                                                <Button Name="BtnOpenToolkitFolder" Content="浏览工具包" Style="{StaticResource StandardBtn}" Height="30" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 执行核心解锁动作大卡片 -->
                                    <Border Name="CardNewUnlock" Style="{StaticResource HoverCardBorder}" Padding="20,18" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="现代固件注入与解锁" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource TextMain}" Margin="0,0,0,10" />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Button Name="BtnApplyNewUnlock" Content="执行引导级解锁 (图形+算力+光追)" Style="{StaticResource PrimaryBtn}" Height="36" Padding="20,0,20,0" Margin="0,0,10,0" />
                                                <Button Name="BtnRollbackPcieOfficial" Content="还原官方出厂固件" Style="{StaticResource StandardBtn}" Height="36" Padding="14,0,14,0" Margin="0,0,10,0" />
                                                <Button Name="BtnFixBcdConflicts" Content="BCD 冲突检测与修复" Style="{StaticResource StandardBtn}" Height="36" Padding="14,0,14,0" />
                                            </StackPanel>
                                            <TextBlock Text="原理：在 ESP 系统引导分区自动注入 NVPermissiveEFI 驱动，在操作系统加载前解除 PCIe Gen2 锁定与图形渲染限制，不刷 VBIOS，安全零风险。" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" LineHeight="16" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 兼容保留 CardOldUnlock 与辅助按键 -->
                                    <Border Name="CardOldUnlock" Visibility="Collapsed">
                                        <StackPanel>
                                            <Button Name="BtnApplyOldUnlock" />
                                            <Button Name="BtnApplySelectedMode" />
                                            <CheckBox Name="ChkUnlockGraphics" IsChecked="True" />
                                            <CheckBox Name="ChkUnlockCompute" IsChecked="True" />
                                            <Button Name="BtnApplyComputeOnly" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 引导安全与 BCD 修复 -->
                                    <Border Style="{StaticResource HoverCardBorder}" Padding="18,14" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="引导配置安全与备份恢复" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextMain}" Margin="0,0,0,6" />
                                            <TextBlock Text="改动前自动导出 Windows BCD 配置。若开机出现多个启动项选择框，可一键清空多余项并重置为原生无缝直启。" FontSize="11" Foreground="{StaticResource TextSub}" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,10" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Name="BtnRepairBootMenu" Content="修复引导菜单 (消除选择框)" Style="{StaticResource StandardBtn}" Height="32" Padding="14,0,14,0" Margin="0,0,10,0" />
                                                <Button Name="BtnRestoreBcdBackup" Content="从 BCD 备份恢复" Style="{StaticResource StandardBtn}" Height="32" Padding="14,0,14,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 专有驱动下载 -->
                                    <Border Style="{StaticResource HoverCardBorder}" Padding="18,14" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="专有图形与光追驱动 (Game Ready 优化版)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextMain}" />
                                                <TextBlock Text="包含 616.92 光追完整支持版与 582.78 稳定功耗版，已集成驱动签名与图形穿透补丁。" FontSize="11" Foreground="{StaticResource TextSub}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Name="BtnDownloadRtDriver" Content="下载光追驱动" Style="{StaticResource PrimaryBtn}" Height="30" Padding="12,0,12,0" Margin="0,0,8,0" />
                                                <Button Name="BtnOpenDriverFolder" Content="浏览驱动库" Style="{StaticResource StandardBtn}" Height="30" Padding="12,0,12,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 矿卡矩阵总览与专属型号配置 (50HX, 40HX, 30HX) -->
                                    <Border Style="{StaticResource HoverCardBorder}" Padding="18,16">
                                        <StackPanel>
                                            <TextBlock Text="HX 家族矿卡矩阵配置" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextMain}" Margin="0,0,0,10" />
                                            <WrapPanel Margin="0,0,0,10">
                                                <RadioButton Name="RadioGpu90hx" Content="CMP 90HX" Style="{StaticResource GpuModelRadio}" IsChecked="True" Margin="0,0,8,6" />
                                                <RadioButton Name="RadioGpu50hx" Content="CMP 50HX" Style="{StaticResource GpuModelRadio}" Margin="0,0,8,6" />
                                                <RadioButton Name="RadioGpu40hx" Content="CMP 40HX" Style="{StaticResource GpuModelRadio}" Margin="0,0,8,6" />
                                                <RadioButton Name="RadioGpu30hx" Content="CMP 30HX" Style="{StaticResource GpuModelRadio}" Margin="0,0,8,6" />
                                            </WrapPanel>

                                            <!-- 快捷部署按钮组 -->
                                            <WrapPanel>
                                                <Button Name="BtnDeploy90hxFull" Content="90HX 全功能部署" Style="{StaticResource StandardBtn}" Height="30" Margin="0,0,8,6" />
                                                <Button Name="BtnDeploy90hxCompute" Content="90HX 仅计算部署" Style="{StaticResource StandardBtn}" Height="30" Margin="0,0,8,6" />
                                                <Button Name="BtnRun40hxInstaller" Content="40HX 安装脚本" Style="{StaticResource StandardBtn}" Height="30" Margin="0,0,8,6" />
                                                <Button Name="BtnRun40hxCheck" Content="40HX 状态检查" Style="{StaticResource StandardBtn}" Height="30" Margin="0,0,8,6" />
                                                <Button Name="BtnRun30hxSetup" Content="30HX 安装向导" Style="{StaticResource StandardBtn}" Height="30" Margin="0,0,8,6" />
                                                <Button Name="BtnRun30hxReBar" Content="30HX ReBar 激活" Style="{StaticResource StandardBtn}" Height="30" Margin="0,0,8,6" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 右侧状态与实时日志 -->
                            <Border Grid.Column="1" Style="{StaticResource HoverCardBorder}" Padding="16,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- 解锁双环刻度盘 (兼容 RingUnlockTemp / RingUnlockPower) -->
                                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                        <TextBlock Text="固件遥测仪表" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextMain}" Margin="0,0,0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- 核心温度 -->
                                            <Grid Grid.Column="0" Width="82" Height="82" HorizontalAlignment="Center">
                                                <Ellipse Stroke="#E5E5EA" StrokeThickness="6" />
                                                <Ellipse Name="RingUnlockTemp" Stroke="{StaticResource AccentBlue}" StrokeThickness="6" StrokeDashArray="1 400" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse.RenderTransform>
                                                        <RotateTransform Angle="-90" />
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Name="TxtRingUnlockTempVal" Text="--°" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="温度" FontSize="9.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                            <!-- 功耗 -->
                                            <Grid Grid.Column="1" Width="82" Height="82" HorizontalAlignment="Center">
                                                <Ellipse Stroke="#E5E5EA" StrokeThickness="6" />
                                                <Ellipse Name="RingUnlockPower" Stroke="{StaticResource SuccessGreen}" StrokeThickness="6" StrokeDashArray="1 400" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse.RenderTransform>
                                                        <RotateTransform Angle="-90" />
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Name="TxtRingUnlockPowerVal" Text="--W" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="功耗" FontSize="9.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>

                                    <!-- 矿卡列表展示 -->
                                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                        <TextBlock Text="检测到的矿卡硬件列表" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
                                        <Border Background="{StaticResource BgSubtle}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="4" MaxHeight="100">
                                            <ListBox Name="LstMiningGpus" BorderThickness="0" Background="Transparent" />
                                        </Border>
                                    </StackPanel>

                                    <!-- 实时日志输出 -->
                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="固件操作日志" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,0,0,6" />
                                        <Border Background="#1C1C1E" CornerRadius="10" Padding="10,8">
                                            <TextBox Name="TxtSideLogUnlock" Style="{StaticResource TerminalLogBoxStyle}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Height="190" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ======================================================== -->
                    <!-- 工作区 3：显卡型号深度伪装中心 (PageSpoof)                 -->
                    <!-- ======================================================== -->
                    <Grid Name="PageSpoof" Visibility="Collapsed" Margin="22,18,22,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 头部标题 -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource AccentBlue}" Margin="0,0,8,0" />
                                    <TextBlock Text="显卡型号深度伪装中心" Style="{StaticResource PageTitle}" />
                                </StackPanel>
                                <TextBlock Text="纯注册表与图形属性映射 · 零破坏 INF 驱动数字签名 · 76 款全系列型号分类支持" Style="{StaticResource PageDesc}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,14,10">
                                <StackPanel>

                                    <!-- 核心参数操作大卡片 -->
                                    <Border Style="{StaticResource HoverCardBorder}" Padding="20,16" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
