<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HX 智能硬件助手"
        Width="400" Height="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 基础色彩系统 (Apple Studio 风格) -->
        <SolidColorBrush x:Key="StudioBg" Color="#FBFBFD" />
        <SolidColorBrush x:Key="StudioWhite" Color="#FFFFFF" />
        <SolidColorBrush x:Key="StudioCardBg" Color="#F5F5F7" />
        <SolidColorBrush x:Key="StudioBorder" Color="#E5E5EA" />
        <SolidColorBrush x:Key="StudioBorderSubtle" Color="#F0F0F3" />
        <SolidColorBrush x:Key="StudioTextDark" Color="#1D1D1F" />
        <SolidColorBrush x:Key="StudioTextMuted" Color="#86868B" />
        <SolidColorBrush x:Key="StudioAccentBlue" Color="#0071E3" />
        <SolidColorBrush x:Key="StudioAccentBlueHover" Color="#0077ED" />
        <SolidColorBrush x:Key="StudioAccentGreen" Color="#34C759" />

        <!-- 阴影定义 -->
        <DropShadowEffect x:Key="StudioFloatShadow" Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.14" Direction="270" />
        <DropShadowEffect x:Key="PetBadgeShadow" Color="#000000" BlurRadius="20" ShadowDepth="6" Opacity="0.22" Direction="270" />
        <DropShadowEffect x:Key="AntennaGlowShadow" Color="#00C6FF" BlurRadius="12" ShadowDepth="0" Opacity="0.85" />
        <DropShadowEffect x:Key="EyeGlowShadow" Color="#00F2FE" BlurRadius="6" ShadowDepth="0" Opacity="0.6" />
        <DropShadowEffect x:Key="BubbleShadow" Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.05" Direction="270" />

        <!-- 圆角按钮通用样式 -->
        <Style x:Key="IconActionButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 极客萌宠平滑呼吸微动效 Storyboard -->
        <Storyboard x:Key="PetBreathingStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <!-- 身体平滑呼吸微动 (0.985 ~ 1.015) -->
            <DoubleAnimation Storyboard.TargetName="PetBodyScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.985" To="1.015"
                             Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- 天线发光球微闪脉冲 (0.5 ~ 1.0) -->
            <DoubleAnimation Storyboard.TargetName="AntennaGlowDot"
                             Storyboard.TargetProperty="Opacity"
                             From="0.45" To="1.0"
                             Duration="0:0:1.2">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- 眼睛晶蓝高光微弱浮动 -->
            <DoubleAnimation Storyboard.TargetName="EyeLightGleam"
                             Storyboard.TargetProperty="Opacity"
                             From="0.8" To="1.0"
                             Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 头部小萌宠独立呼吸动效 (对话窗顶部) -->
        <Storyboard x:Key="HeaderPetBreathingStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="HeaderPetScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.985" To="1.015"
                             Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HeaderAntennaGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.45" To="1.0"
                             Duration="0:0:1.2">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 眨眼小动效 -->
        <Storyboard x:Key="PetBlinkStoryboard">
            <DoubleAnimation Storyboard.TargetName="PetEyesScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1.0" To="0.1"
                             Duration="0:0:0.12"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
            <!-- 圆角普通按钮样式 (浅灰底/白底) -->
        <Style x:Key="RoundedLightBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource StudioBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource StudioTextDark}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F2F3F5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 圆角强调按钮样式 (科技蓝) -->
        <Style x:Key="RoundedPrimaryBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{StaticResource StudioAccentBlue}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource StudioAccentBlueHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 提问芯片按钮样式 -->
        <Style x:Key="ChipBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#0284C7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0F2FE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#BAE6FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource PetBreathingStoryboard}" />
            <BeginStoryboard Storyboard="{StaticResource HeaderPetBreathingStoryboard}" />
        </EventTrigger>
    </Window.Triggers>

    <!-- 顶层主容器，全透明背景 -->
    <Grid Name="RootContainer" Background="Transparent" SnapsToDevicePixels="True">

        
        <!-- 模式 1：圆形萌宠微标模式 (Mini Pet Mode，收起态)                -->
        
        <Border Name="MiniPetHost"
                Width="92" Height="92"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,14,14"
                Background="Transparent"
                Cursor="Hand"
                ToolTip="HX 智能硬件助手 (双击展开对话，右键更多选项，按住可任意拖动)">

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- 底部毛玻璃发光底盘与精致光圈 -->
                <Ellipse Width="82" Height="82" Effect="{StaticResource PetBadgeShadow}">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.6" RadiusY="0.6">
                            <GradientStop Color="#FFFFFF" Offset="0" />
                            <GradientStop Color="#F0F2F6" Offset="0.8" />
                            <GradientStop Color="#E2E5EC" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="82" Height="82" Stroke="#FFFFFF" StrokeThickness="1.8" Opacity="0.9" />
                <Ellipse Width="80" Height="80" Stroke="#E2E8F0" StrokeThickness="1" />

                <!-- 极客机械萌宠主体 (纯矢量 XAML 绘制，带 ScaleY 呼吸动效) -->
                <Grid Name="PetCharacterHost" Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="PetBodyScale" ScaleX="1.0" ScaleY="1.0" CenterX="36" CenterY="54" />
                    </Grid.RenderTransform>

                    <!-- 1. 发光微弯天线 -->
                    <!-- 微弯天线杆 -->
                    <Path Data="M 37,20 C 37,11 44,7 48,3"
                          Stroke="#94A3B8" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M 38,20 C 38,12 44.5,8 48.2,4"
                          Stroke="#CBD5E1" StrokeThickness="1" Opacity="0.8" />
                    <!-- 天线发光能量球 (微闪呼吸) -->
                    <Ellipse x:Name="AntennaGlowDot"
                             Width="9" Height="9"
                             Margin="44,0,0,0"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Effect="{StaticResource AntennaGlowShadow}">
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.4,0.3" GradientOrigin="0.4,0.3" RadiusX="0.7" RadiusY="0.7">
                                <GradientStop Color="#FFFFFF" Offset="0" />
                                <GradientStop Color="#38BDF8" Offset="0.45" />
                                <GradientStop Color="#0284C7" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- 2. 耳麦/侧边机械旋钮 (左右对称) -->
                    <!-- 左耳麦 -->
                    <Border Width="6" Height="14" CornerRadius="3" Background="#1E2026" BorderBrush="#38BDF8" BorderThickness="1"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,8,0,0">
                        <Rectangle Width="2" Height="6" Fill="#38BDF8" RadiusX="1" RadiusY="1" VerticalAlignment="Center" />
                    </Border>
                    <!-- 右耳麦 -->
                    <Border Width="6" Height="14" CornerRadius="3" Background="#1E2026" BorderBrush="#38BDF8" BorderThickness="1"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,5,0">
                        <Rectangle Width="2" Height="6" Fill="#38BDF8" RadiusX="1" RadiusY="1" VerticalAlignment="Center" />
                    </Border>

                    <!-- 3. 超椭圆曜石黑机身 (Obsidian Black Body) -->
                    <Border Width="56" Height="46"
                            CornerRadius="19"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,8,0,0"
                            BorderBrush="#383B46" BorderThickness="1.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#282A33" Offset="0" />
                                <GradientStop Color="#181920" Offset="0.5" />
                                <GradientStop Color="#0F1014" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid>
                            <!-- 机身顶部柔和月牙高光玻璃弧面 -->
                            <Border Height="18" CornerRadius="18,18,6,6" VerticalAlignment="Top" Margin="2,1,2,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#30FFFFFF" Offset="0" />
                                        <GradientStop Color="#05FFFFFF" Offset="0.8" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- 4. 高透黑色显示面罩屏 -->
                            <Border Width="46" Height="26" CornerRadius="12"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0"
                                    Background="#08090C" BorderBrush="#20222A" BorderThickness="1">
                                <Grid>
                                    <!-- 晶蓝渐变大眼睛 (可动/可眨眼) -->
                                    <Grid Name="PetEyesScale" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" CenterX="16" CenterY="7" />
                                        </Grid.RenderTransform>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 左眼 -->
                                        <Border Grid.Column="0" Width="9" Height="13" CornerRadius="4.5" Effect="{StaticResource EyeGlowShadow}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="#7DD3FC" Offset="0" />
                                                    <GradientStop Color="#0284C7" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <!-- 眼内亮白高光反光点 -->
                                            <Canvas>
                                                <Ellipse Canvas.Left="2" Canvas.Top="2" Width="3" Height="3" Fill="#FFFFFF" x:Name="EyeLightGleam" />
                                                <Ellipse Canvas.Left="4.5" Canvas.Top="7" Width="1.8" Height="1.8" Fill="#BAE6FD" />
                                            </Canvas>
                                        </Border>

                                        <!-- 右眼 -->
                                        <Border Grid.Column="2" Width="9" Height="13" CornerRadius="4.5" Effect="{StaticResource EyeGlowShadow}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop Color="#7DD3FC" Offset="0" />
                                                    <GradientStop Color="#0284C7" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <!-- 眼内亮白高光反光点 -->
                                            <Canvas>
                                                <Ellipse Canvas.Left="2" Canvas.Top="2" Width="3" Height="3" Fill="#FFFFFF" />
                                                <Ellipse Canvas.Left="4.5" Canvas.Top="7" Width="1.8" Height="1.8" Fill="#BAE6FD" />
                                            </Canvas>
                                        </Border>
                                    </Grid>

                                    <!-- 5. 软萌粉色腮红 (左右透亮晕光) -->
                                    <Ellipse Width="6" Height="3.5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,3" Opacity="0.55">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#FF6488" Offset="0" />
                                                <GradientStop Color="#00FF6488" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Width="6" Height="3.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,3" Opacity="0.55">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#FF6488" Offset="0" />
                                                <GradientStop Color="#00FF6488" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                            </Border>

                            <!-- 6. 金属小扳手勋章 (下胸部极客硬件徽章) -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2">
                                <!-- 勋章底托 (科技蓝光环) -->
                                <Ellipse Width="11" Height="11" Fill="#0F172A" Stroke="#0284C7" StrokeThickness="1.2" />
                                <!-- 迷你银色金属小扳手 -->
                                <Path Data="M 3,8 L 7.5,3.5 M 6.5,2.5 L 8.5,1 C 9.5,0.5 10.5,1.5 10,2.5 L 8.5,4.5 L 9.5,6 C 9,7 8,7.5 7,6.5 Z"
                                      Stroke="#F1F5F9" StrokeThickness="1.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 悬浮在线小绿点 -->
                <Ellipse Width="10" Height="10"
                         Fill="{StaticResource StudioAccentGreen}"
                         Stroke="#FFFFFF" StrokeThickness="2"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,6,6" />
            </Grid>
        </Border>

        
        <!-- 模式 2：精致聊天对话窗口 (Expanded Chat Window Mode，展开态)    -->
        
        <Border Name="ChatWindowHost"
                Width="380" Height="570"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,10,10"
                CornerRadius="20"
                Background="{StaticResource StudioBg}"
                BorderBrush="{StaticResource StudioBorder}"
                BorderThickness="1"
                Effect="{StaticResource StudioFloatShadow}"
                Visibility="Collapsed"
                ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <!-- 0: 顶部标题栏 -->
                    <RowDefinition Height="Auto" />
                    <!-- 1: 可折叠设置抽屉 (API 配置面板) -->
                    <RowDefinition Height="Auto" />
                    <!-- 2: 气泡消息流列表 -->
                    <RowDefinition Height="*" />
                    <!-- 3: 底部圆角输入栏 -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                
                <!-- 0: 顶部标题栏 (支持鼠标拖拽)                              -->
                
                <Border Name="TitleBarDragArea" Grid.Row="0"
                        Background="{StaticResource StudioWhite}"
                        BorderBrush="{StaticResource StudioBorderSubtle}"
                        BorderThickness="0,0,0,1"
                        Padding="14,10,12,10"
                        CornerRadius="20,20,0,0"
                        Cursor="SizeAll">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧萌宠小头像与动效 -->
                        <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="HeaderPetScale" ScaleX="1.0" ScaleY="1.0" CenterX="18" CenterY="28" />
                            </Grid.RenderTransform>
                            <!-- 矢量萌宠微型版 -->
                            <!-- 天线 -->
                            <Path Data="M 18,10 C 18,5 22,3 25,1" Stroke="#94A3B8" StrokeThickness="1.5" />
                            <Ellipse x:Name="HeaderAntennaGlow" Width="5" Height="5" Margin="23,0,0,0" Fill="#0284C7"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Effect="{StaticResource AntennaGlowShadow}" />
                            <!-- 身体 -->
                            <Border Width="30" Height="25" CornerRadius="10" Background="#181920" BorderBrush="#383B46" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1">
                                <Grid>
                                    <!-- 眼睛 -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="5" Height="7" CornerRadius="2.5" Background="#38BDF8" Margin="0,0,6,0" Effect="{StaticResource EyeGlowShadow}" />
                                        <Border Width="5" Height="7" CornerRadius="2.5" Background="#38BDF8" Effect="{StaticResource EyeGlowShadow}" />
                                    </StackPanel>
                                    <!-- 腮红 -->
                                    <Ellipse Width="3" Height="2" Fill="#FF6488" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,3" Opacity="0.7" />
                                    <Ellipse Width="3" Height="2" Fill="#FF6488" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,3" Opacity="0.7" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 标题与状态提示 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="HX 智能硬件助手"
                                           FontWeight="Bold"
                                           FontSize="13.5"
                                           Foreground="{StaticResource StudioTextDark}" />
                                <Border Background="#EEF2F6" CornerRadius="4" Padding="4,1,4,1" Margin="6,0,0,0">
                                    <TextBlock Text="AI 伴侣" FontSize="10" FontWeight="SemiBold" Foreground="#475569" />
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="6.5" Height="6.5" Fill="{StaticResource StudioAccentGreen}" Margin="0,0,5,0" />
                                <TextBlock x:Name="TxtStatus" Text="在线 · 极客硬件大模型就绪" FontSize="11" Foreground="{StaticResource StudioTextMuted}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 右侧操作按钮组 (设置、重置位置、最小化、关闭) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- API 配置齿轮按钮 -->
                            <Button Name="BtnToggleSettings" Style="{StaticResource IconActionButton}" Width="28" Height="28" ToolTip="中转站 API 配置">
                                <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                      Fill="#555861" Width="15" Height="15" Stretch="Uniform" />
                            </Button>

                            <!-- 重置吸附位置按钮 -->
                            <Button Name="BtnResetPos" Style="{StaticResource IconActionButton}" Width="28" Height="28" ToolTip="复位到右下角" Margin="2,0,0,0">
                                <Path Data="M12,4V1L8,5L12,9V6C15.31,6 18,8.69 18,12C18,13.04 17.73,14.03 17.26,14.88L18.72,16.34C19.53,15.11 20,13.62 20,12C20,7.58 16.42,4 12,4M12,18C8.69,18 6,15.31 6,12C6,10.96 6.27,9.97 6.74,9.12L5.28,7.66C4.47,8.89 4,10.38 4,12C4,16.42 7.58,20 12,20V23L16,19L12,15V18Z"
                                      Fill="#555861" Width="14" Height="14" Stretch="Uniform" />
                            </Button>

                            <!-- 最小化收起为圆形萌宠按钮 -->
                            <Button Name="BtnMinimizeToPet" Style="{StaticResource IconActionButton}" Width="28" Height="28" ToolTip="收起为悬浮萌宠" Margin="2,0,0,0">
                                <Path Data="M19,13H5V11H19V13Z" Fill="#555861" Width="14" Height="14" Stretch="Uniform" />
                            </Button>

                            <!-- 关闭/隐藏按钮 -->
                            <Button Name="BtnCloseAssistant" Style="{StaticResource IconActionButton}" Width="28" Height="28" ToolTip="关闭助手" Margin="2,0,0,0">
                                <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                      Fill="#555861" Width="13" Height="13" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                
                <!-- 1: 可折叠设置抽屉 (中转站 API 配置面板)                   -->
                
                <Border Name="SettingsDrawer" Grid.Row="1"
                        Background="#F0F2F6"
                        BorderBrush="{StaticResource StudioBorder}"
                        BorderThickness="0,0,0,1"
                        Padding="14,12,14,12"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="中转站 / OpenAI API 接入设置" FontWeight="Bold" FontSize="12" Foreground="{StaticResource StudioTextDark}" Margin="0,0,0,8" />

                        <!-- API URL -->
                        <TextBlock Text="API Endpoint URL (中转站地址)" FontSize="11" Foreground="{StaticResource StudioTextMuted}" Margin="0,0,0,3" />
                        <Border Background="#FFFFFF" CornerRadius="6" BorderBrush="{StaticResource StudioBorder}" BorderThickness="1" Height="28" Margin="0,0,0,8">
                            <TextBox Name="TxtApiUrl" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0,8,0"
                                     FontSize="11.5" Foreground="{StaticResource StudioTextDark}" Text="https://api.openai.com/v1" />
                        </Border>

                        <!-- API Key -->
                        <TextBlock Text="API Key (密钥)" FontSize="11" Foreground="{StaticResource StudioTextMuted}" Margin="0,0,0,3" />
                        <Border Background="#FFFFFF" CornerRadius="6" BorderBrush="{StaticResource StudioBorder}" BorderThickness="1" Height="28" Margin="0,0,0,8">
                            <TextBox Name="TxtApiKey" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0,8,0"
                                     FontSize="11.5" Foreground="{StaticResource StudioTextDark}" />
                        </Border>

                        <!-- 模型名称 -->
                        <TextBlock Text="Model Name (模型名称)" FontSize="11" Foreground="{StaticResource StudioTextMuted}" Margin="0,0,0,3" />
                        <Border Background="#FFFFFF" CornerRadius="6" BorderBrush="{StaticResource StudioBorder}" BorderThickness="1" Height="28" Margin="0,0,0,10">
                            <TextBox Name="TxtModelName" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0,8,0"
                                     FontSize="11.5" Foreground="{StaticResource StudioTextDark}" Text="gpt-4o-mini" />
                        </Border>

                        <!-- 操作按键 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Name="BtnTestConnection" Grid.Column="0" Height="28" Style="{StaticResource RoundedLightBtn}" Content="测试连接" FontSize="11.5" />

                            <Button Name="BtnSaveSettings" Grid.Column="2" Height="28" Style="{StaticResource RoundedPrimaryBtn}" Content="保存配置" FontSize="11.5" FontWeight="SemiBold" />
                        </Grid>

                        <TextBlock Text="* 未配置或网络不通时，助手将自动切换为本机 CMP 硬件智能专家库解答。"
                                   FontSize="10" Foreground="{StaticResource StudioTextMuted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                
                <!-- 2: 气泡消息流列表 (ScrollViewer + StackPanel)             -->
                
                <ScrollViewer Name="ChatScrollViewer" Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="12,12,12,6"
                              Background="Transparent">
                    <StackPanel Name="MessagesPanel">

                        <!-- 助手欢迎卡片 -->
                        <Border Background="#FFFFFF" CornerRadius="14" BorderBrush="{StaticResource StudioBorderSubtle}" BorderThickness="1"
                                Padding="12,10,12,10" Margin="0,0,24,10" Effect="{StaticResource BubbleShadow}">
                            <StackPanel>
                                <TextBlock Text="你好！我是你的专属极客硬件助手小 HX 🤖" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource StudioTextDark}" />
                                <TextBlock Text="我可以协助你排查 CMP 90HX/50HX 驱动状态、双显卡调度、改名 3080/4080、DLSS 5 补丁打不上、以及实时温度功耗监测。点击下方快捷卡片或直接提问吧！"
                                           FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" Margin="0,5,0,8" LineHeight="17" />

                                <!-- 推荐快捷提问芯片 -->
                                <WrapPanel Margin="0,2,0,0">
                                    <Button Name="QuickQ1" Content="📊 查询显卡实时温度与功耗" Style="{StaticResource ChipBtn}" Margin="0,0,6,6" Padding="8,4,8,4" FontSize="11" />
                                    <Button Name="QuickQ2" Content="⚡ 90HX 解锁与超频建议" Style="{StaticResource ChipBtn}" Margin="0,0,6,6" Padding="8,4,8,4" FontSize="11" />
                                    <Button Name="QuickQ3" Content="🎮 双显卡调度如何设置？" Style="{StaticResource ChipBtn}" Margin="0,0,6,6" Padding="8,4,8,4" FontSize="11" />
                                    <Button Name="QuickQ4" Content="🛠 DLSS 5 与覆盖修复步骤" Style="{StaticResource ChipBtn}" Margin="0,0,6,6" Padding="8,4,8,4" FontSize="11" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                
                <!-- 3: 底部圆角文本输入框 + 发送按钮                          -->
                
                <Border Grid.Row="3"
                        Background="{StaticResource StudioWhite}"
                        BorderBrush="{StaticResource StudioBorderSubtle}"
                        BorderThickness="0,1,0,0"
                        Padding="12,10,12,10"
                        CornerRadius="0,0,20,20">
                    <Grid>
                        <!-- 输入背景框 -->
                        <Border Background="{StaticResource StudioCardBg}"
                                CornerRadius="18"
                                BorderBrush="{StaticResource StudioBorder}"
                                BorderThickness="1"
                                MinHeight="38"
                                Padding="12,4,44,4">
                            <Grid>
                                <!-- 占位文字提示 (Placeholder) -->
                                <TextBlock Name="TxtPlaceholder"
                                           Text="输入硬件问题... (Enter 发送, Shift+Enter 换行)"
                                           FontSize="11.5"
                                           Foreground="{StaticResource StudioTextMuted}"
                                           VerticalAlignment="Center"
                                           Margin="2,0,0,0"
                                           IsHitTestVisible="False" />

                                <!-- 多行输入框 -->
                                <TextBox Name="TxtInput"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="12"
                                         Foreground="{StaticResource StudioTextDark}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Center"
                                         MaxHeight="80"
                                         VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>

                        <!-- 右侧圆形科技蓝发送按钮 -->
                        <Button Name="BtnSend"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Width="30" Height="30"
                                Margin="0,0,4,4"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="SendBd" Background="{StaticResource StudioAccentBlue}" CornerRadius="15">
                                        <!-- 纸飞机发送矢量图标 -->
                                        <Path Data="M2,21L23,12L2,3V10L17,12L2,14V21Z"
                                              Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SendBd" Property="Background" Value="{StaticResource StudioAccentBlueHover}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="SendBd" Property="Background" Value="#CBD5E1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

    </Grid>
</Window>