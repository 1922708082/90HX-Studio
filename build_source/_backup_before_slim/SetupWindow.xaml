<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CMP 90HX 控制中心 - 安装向导"
        Width="580" Height="410" MinWidth="560" MinHeight="390"
        WindowStartupLocation="CenterScreen"
        Background="#181B20" Foreground="#D1D5DB"
        FontFamily="Microsoft YaHei, Segoe UI, sans-serif"
        FontSize="12" ResizeMode="CanMinimize">

    <Window.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#13161A" />
        <SolidColorBrush x:Key="BgPanel" Color="#1E232A" />
        <SolidColorBrush x:Key="BorderColor" Color="#353D4A" />
        <SolidColorBrush x:Key="AccentGreen" Color="#5A9E24" />

        <Style x:Key="StdBtn" TargetType="Button">
            <Setter Property="Background" Value="#2D3542" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="BorderBrush" Value="#414C5E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PriBtn" TargetType="Button" BasedOn="{StaticResource StdBtn}">
            <Setter Property="Background" Value="#5A9E24" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#6CB82B" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D1D5DB" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Background="#181B20">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <!-- 顶部横幅 -->
        <Border Grid.Row="0" Background="#14171C" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="20,0,20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" Background="#262D36" BorderBrush="#5A9E24" BorderThickness="1.5" CornerRadius="4" Margin="0,0,14,0">
                    <TextBlock Text="90" Foreground="#5A9E24" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CMP 90HX 控制中心 安装向导" FontSize="14.5" FontWeight="Bold" Foreground="#F3F4F6" />
                        <Border Background="#2B3648" CornerRadius="2" Padding="5,1,5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v2.5 Pro" FontSize="10" Foreground="#93C5FD" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="GA102 矿卡全套游戏与算力解锁控制台 | 显卡伪装 · 游戏覆盖 · PCIe 速率 · 双卡调用" FontSize="11" Foreground="#9CA3AF" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Border Grid.Row="1" Background="#181B20" Padding="24,18,24,14">
            <StackPanel>
                <TextBlock Text="安装目标文件夹 (默认安装至 Program Files):" Foreground="#D1D5DB" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="84" />
                    </Grid.ColumnDefinitions>
                    <TextBox Name="TxtInstallPath" Text="C:\Program Files\CMP90HX_Toolbox" Height="30" Background="#111418" Foreground="#F3F4F6" BorderBrush="{StaticResource BorderColor}" Padding="8,5,8,5" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Name="BtnBrowse" Grid.Column="1" Content="浏览..." Style="{StaticResource StdBtn}" Height="30" />
                </Grid>

                <CheckBox Name="ChkDesktopShortcut" Content="在桌面创建快捷方式 (推荐)" IsChecked="True" />
                <CheckBox Name="ChkStartMenu" Content="在开始菜单创建快捷方式及程序组" IsChecked="True" />
                <CheckBox Name="ChkLaunchNow" Content="安装完成后立即启动控制中心" IsChecked="True" />

                <ProgressBar Name="ProgressBarInstall" Height="8" Background="#111418" Foreground="#5A9E24" BorderBrush="{StaticResource BorderColor}" Margin="0,16,0,6" Visibility="Collapsed" />
                <TextBlock Name="TxtStatus" Text="就绪。点击下方【立即安装】开始部署。" Foreground="#9CA3AF" FontSize="11" />
            </StackPanel>
        </Border>

        <!-- 底部控制栏 -->
        <Border Grid.Row="2" Background="#14171C" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="20,0,20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="RainCandy Technology · 极速硬件调谐平台" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Name="BtnInstall" Content="立即安装" Style="{StaticResource PriBtn}" Width="100" Margin="0,0,10,0" />
                    <Button Name="BtnCancel" Content="取消" Style="{StaticResource StdBtn}" Width="80" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>