
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,16">
                    <StackPanel>
                        <!-- 说明卡片 -->
                        <Border Background="{StaticResource BgBanner}" BorderBrush="{StaticResource BorderBanner}" BorderThickness="1" CornerRadius="12" Padding="18,12" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="全系矿卡型号深度伪装 (设备管理器/DirectX 同步)" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" FontSize="13.5" />
                                </StackPanel>
                                <TextBlock Text="将 CMP 矿卡伪装为对应 GeForce 架构，解锁设备管理器与 3A 游戏识别。" Foreground="{StaticResource TextSub}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 多卡切换选择器 -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="20,14" Margin="0,0,0,12" Effect="{StaticResource ShadowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="2.6*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="选择要操作的显卡:" VerticalAlignment="Center" Foreground="{StaticResource TextSub}" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,12,0" />
                                <ComboBox Name="CmbSpoofTargetCard" Grid.Column="1" Height="34" SelectedIndex="0" Margin="0,0,14,0" />
                                <Button Name="BtnSpoofAllGpus" Grid.Column="2" Content="⚡ 一键全机多卡全部伪装" Style="{StaticResource PrimaryBtn}" Height="34" Padding="16,0,16,0" />
                            </Grid>
                        </Border>

                        <!-- 检测卡片 -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,12" Effect="{StaticResource ShadowCard}">
                            <StackPanel>
                                <TextBlock Text="当前选中显卡的驱动与底层状态" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" FontSize="13.5" Margin="0,0,0,12" />

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="驱动注册表项 (Class):" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />
                                    <TextBlock Name="TxtClassSubKey" Grid.Row="0" Grid.Column="1" Text="4d36e968-e325-11ce-bfc1-08002be10318" Foreground="{StaticResource TextMain}" Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="当前显示名称:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />
                                    <TextBlock Name="TxtCurrentDriverDesc" Grid.Row="1" Grid.Column="1" Text="NVIDIA CMP 90HX" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreen}" Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="匹配硬件 PCI ID:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />
                                    <TextBlock Name="TxtCurrentGpuMatchId" Grid.Row="2" Grid.Column="1" Text="PCI\VEN_10DE&amp;DEV_220D&amp;SUBSYS_146710DE" Foreground="{StaticResource TextMain}" Margin="0,0,0,8" FontFamily="Consolas, Cascadia Mono" FontSize="11.5" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="目标伪装型号 / 架构:" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Name="TxtDirectXDesc" Grid.Row="3" Grid.Column="1" Text="NVIDIA GeForce RTX 3080 (GA102 · sm_86)" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 操作卡片 -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="12" Padding="20,14" Effect="{StaticResource ShadowCard}">
                            <StackPanel>
                                <TextBlock Text="执行操作" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" FontSize="13.5" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Name="BtnRenameTo3080" Content="一键伪装当前显卡" Style="{StaticResource PrimaryBtn}" Height="34" Padding="18,0,18,0" Margin="0,0,10,0" />
                                    <Button Name="BtnRestore90hx" Content="恢复当前显卡出厂原名" Style="{StaticResource StandardBtn}" Height="34" Padding="16,0,16,0" Margin="0,0,10,0" />
                                    <Button Name="BtnQuickRestartDriver" Content="快捷软重启驱动" Style="{StaticResource StandardBtn}" Height="34" Padding="16,0,16,0" ToolTip="刷新显示服务，无需重启电脑即可重载显卡名称" />
                                </StackPanel>
                                <TextBlock Text="说明：修改完成后，可直接点击【快捷软重启驱动】使设备管理器与系统信息立刻刷新。" Foreground="{StaticResource TextMuted}" FontSize="10.5" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            