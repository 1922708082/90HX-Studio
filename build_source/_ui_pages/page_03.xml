
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,28,24">
                    <StackPanel>
                        <Border Background="{StaticResource BgBanner}" BorderBrush="{StaticResource BorderBanner}" BorderThickness="1" CornerRadius="13" Padding="18,12" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="NVIDIA App 游戏内覆盖解锁机制 (ShadowPlay)" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" FontSize="13.5" />
                                </StackPanel>
                                <TextBlock Text="绕过官方白名单限制，开启 Alt+R 性能悬浮窗与 Alt+Z 高清录屏功能。" Foreground="{StaticResource TextSub}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="13" Padding="20,18" Margin="0,0,0,16" Effect="{StaticResource ShadowCard}">
                            <StackPanel>
                                <TextBlock Text="NVIDIA App 运行环境检测" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" FontSize="14" Margin="0,0,0,14" />

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="安装主程序目录:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10" />
                                    <TextBlock Name="TxtNvAppPath" Grid.Row="0" Grid.Column="1" Text="检测中..." Foreground="{StaticResource TextMain}" Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="补丁注入状态:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10" />
                                    <TextBlock Name="TxtOverlayPatchState" Grid.Row="1" Grid.Column="1" Text="检测中..." FontWeight="SemiBold" Foreground="{StaticResource SuccessGreen}" Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="官方备份状态:" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Name="TxtOverlayBakState" Grid.Row="2" Grid.Column="1" Text="检测中..." Foreground="{StaticResource TextMain}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="13" Padding="20,18" Effect="{StaticResource ShadowCard}">
                            <StackPanel>
                                <TextBlock Text="执行操作" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" FontSize="14" Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Name="BtnUnlockOverlay" Content="一键解锁游戏覆盖 (ShadowPlay)" Style="{StaticResource PrimaryBtn}" Height="36" Width="240" Margin="0,0,12,0" />
                                    <Button Name="BtnRestoreOverlay" Content="恢复官方原始未修改版本" Style="{StaticResource StandardBtn}" Height="36" Width="190" Margin="0,0,12,0" />
                                    <Button Name="BtnCleanCefAndRestart" Content="清理 CEF 缓存并重启" Style="{StaticResource StandardBtn}" Height="36" Width="170" />
                                </StackPanel>
                                <TextBlock Text="说明：解锁后可在游戏内按 Alt+R 查看实时性能监控浮窗，按 Alt+Z 呼出控制中心进行高清录屏与游戏滤镜。" Foreground="{StaticResource TextMuted}" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            